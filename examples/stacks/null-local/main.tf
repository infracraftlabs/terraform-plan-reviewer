# Tiny local-only stack used to prove tfreview parses real `terraform show -json` output.
# Providers: hashicorp/null and hashicorp/local. No cloud provider, no credentials.
# Regenerate: terraform init && terraform plan -out plan.out && terraform show -json plan.out > ../../plans/07-real-null-local.plan.json

terraform {
  required_providers {
    null  = { source = "hashicorp/null", version = "~> 3.2" }
    local = { source = "hashicorp/local", version = "~> 2.5" }
  }
}

variable "api_token" {
  description = "Fake token to show that sensitive values are masked in plan JSON."
  type        = string
  sensitive   = true
  default     = "fake-token-not-real-0000"
}

resource "null_resource" "release" {
  triggers = {
    version = "1.2.3"
  }
}

resource "local_sensitive_file" "config" {
  filename = "${path.module}/out/config.env"
  content  = "API_TOKEN=${var.api_token}\n"
}

resource "local_file" "readme" {
  filename = "${path.module}/out/README.txt"
  content  = "Generated by the tfreview example stack.\n"
}
